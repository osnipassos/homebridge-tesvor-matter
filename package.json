{
  "displayName": "Homebridge Tesvor Matter",
  "name": "homebridge-tesvor-matter",
  "version": "2.0.0",
  "author": "osnipassos",
  "description": "Homebridge 2.0 Plugin for Tesvor/WeBack Robot Vacuum Cleaner",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/osnipassos/homebridge-tesvor-matter.git"
  },
  "bugs": {
    "url": "https://github.com/osnipassos/homebridge-tesvor-matter/issues"
  },
  "homepage": "https://github.com/osnipassos/homebridge-tesvor-matter#readme",
  "engines": {
    "node": ">=18.20.4",
    "homebridge": ">=2.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist/",
    "config.schema.json",
    "homebridge-tesvor.png",
    "homebridge-tesvor.svg"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "rimraf ./dist && tsc",
    "watch": "npm run build && npm link && nodemon",
    "lint": "eslint src/**/*.ts --max-warnings=0",
    "lint:fix": "eslint --fix src/**/*.ts --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "publish:patch": "npm version patch && git push --follow-tags && npm publish",
    "publish:minor": "npm version minor && git push --follow-tags && npm publish",
    "publish:major": "npm version major && git push --follow-tags && npm publish",
    "publish:beta": "npm version prerelease --preid beta && git push --follow-tags && npm publish --tag=beta"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge-tesvor",
    "tesvor",
    "weback",
    "robot vacuum",
    "rvc",
    "matter"
  ],
  "peerDependencies": {
    "homebridge": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "homebridge": {
      "optional": true
    }
  },
  "dependencies": {
    "got": "^11.8.5",
    "ws": "^7.5.9"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "homebridge": "^2.0.0",
    "nodemon": "^3.0.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
}
