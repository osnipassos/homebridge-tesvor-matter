{
  "pluginAlias": "HomebridgeTesvorMatter",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Plugin for Tesvor/WeBack robot vacuums via Matter. Requires Homebridge 2.0 with Matter enabled, running as a child bridge.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Homebridge Tesvor Matter"
      },
      "username": {
        "title": "Username",
        "type": "string",
        "description": "WeBack account email or phone number (phone without country code, e.g. 11912345678)"
      },
      "password": {
        "title": "Password",
        "type": "string",
        "description": "WeBack account password"
      },
      "country": {
        "title": "Country Code",
        "type": "string",
        "default": "0055",
        "description": "Country calling code (e.g. 0055 for Brazil, 0001 for US, 0044 for UK)"
      },
      "startMode": {
        "title": "Cleaning Mode",
        "type": "string",
        "default": "AutoClean",
        "oneOf": [
          { "title": "Auto Clean", "enum": ["AutoClean"] },
          { "title": "Edge Clean", "enum": ["EdgeClean"] },
          { "title": "Spot Clean", "enum": ["SpotClean"] },
          { "title": "Room Clean", "enum": ["RoomClean"] },
          { "title": "Smart Clean", "enum": ["SmartClean"] }
        ],
        "description": "Cleaning mode used when started from Apple Home"
      },
      "stopMode": {
        "title": "Stop Action",
        "type": "string",
        "default": "BackCharging",
        "oneOf": [
          { "title": "Return to base", "enum": ["BackCharging"] },
          { "title": "Stop in place", "enum": ["Standby"] }
        ],
        "description": "What the vacuum does when it receives a stop command"
      },
      "fanMode": {
        "title": "Fan Power",
        "type": "string",
        "default": "Normal",
        "oneOf": [
          { "title": "Normal", "enum": ["Normal"] },
          { "title": "Strong", "enum": ["Strong"] }
        ],
        "description": "Suction power during cleaning"
      },
      "appName": {
        "title": "App",
        "type": "string",
        "default": "WeBack",
        "oneOf": [
          { "title": "WeBack", "enum": ["WeBack"] },
          { "title": "Redmond", "enum": ["Redmond"] }
        ],
        "description": "Original device app"
      }
    },
    "required": ["username", "password", "country", "startMode", "stopMode", "fanMode", "appName"]
  }
}
