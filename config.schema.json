{
  "pluginAlias": "HomebridgeTesvor",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Plugin para aspiradores Tesvor/WeBack via Matter. Requer Homebridge 2.0 com Matter habilitado.",
  "schema": {
    "type": "object",
    "properties": {
      "username": {
        "title": "Username",
        "type": "string",
        "required": true,
        "description": "E-mail ou telefone da conta WeBack (telefone sem código do país, ex: 11912345678)"
      },
      "password": {
        "title": "Password",
        "type": "string",
        "required": true,
        "description": "Senha da conta WeBack"
      },
      "country": {
        "title": "Country Code",
        "type": "string",
        "required": true,
        "default": "0055",
        "description": "Código do país (ex: 0055 para Brasil, 0049 para Alemanha)"
      },
      "startMode": {
        "title": "Modo de Limpeza",
        "type": "string",
        "default": "AutoClean",
        "oneOf": [
          { "title": "Auto Clean", "enum": ["AutoClean"] },
          { "title": "Edge Clean", "enum": ["EdgeClean"] },
          { "title": "Spot Clean", "enum": ["SpotClean"] },
          { "title": "Room Clean", "enum": ["RoomClean"] },
          { "title": "Smart Clean", "enum": ["SmartClean"] }
        ],
        "description": "Modo de limpeza acionado ao iniciar via Apple Home",
        "required": true
      },
      "stopMode": {
        "title": "Ação ao Parar",
        "type": "string",
        "default": "BackCharging",
        "oneOf": [
          { "title": "Retornar à base", "enum": ["BackCharging"] },
          { "title": "Parar no lugar", "enum": ["Standby"] }
        ],
        "description": "O que o aspirador faz quando recebe o comando de parar",
        "required": true
      },
      "fanMode": {
        "title": "Potência do Ventilador",
        "type": "string",
        "default": "Normal",
        "oneOf": [
          { "title": "Normal", "enum": ["Normal"] },
          { "title": "Forte", "enum": ["Strong"] }
        ],
        "description": "Potência de sucção durante a limpeza",
        "required": true
      },
      "appName": {
        "title": "App",
        "type": "string",
        "default": "WeBack",
        "oneOf": [
          { "title": "WeBack", "enum": ["WeBack"] },
          { "title": "Redmond", "enum": ["Redmond"] }
        ],
        "description": "App original do dispositivo",
        "required": true
      }
    }
  }
}
